//
// Docs: the documents held to what they name
//
// The documents and the modules are the files git tracks, each name read as
// written; where git tracks none, the program says so on standard error and
// ends with status 1.
//
// Every backticked path in a tracked document that begins with a directory
// holding a tracked file names a tracked file or a directory that holds one,
// or a line on standard error names the file, the line and the path, and the
// program ends with status 1; the plan, the findings, the logs and the
// proposals are left out, and so is a path under docs/man/ or docs/modules/,
// which a library's archive alone holds. Every prose paragraph past 150
// words, which no reader takes in whole, is listed on standard error for its
// writer to split at its turn, and the program ends with status 1
// (CLAUDE.md, *Writing*); the log and the proposals are left out. Fenced code
// is read as neither.
//
// A command in a fenced block, an Ernest block aside, gives its description
// after `#`, so that the block pastes as shell: a line that begins with make,
// or with ern or a launcher under bin/ and a word, after an optional sudo and
// words VAR=value, holds no two spaces before its `#`, and a line indented
// under it begins with `#`. A command that ends in `\` runs on to the next
// line. Each line that does not is a line on standard error naming the file
// and the line, and the program ends with status 1; the log and the proposals
// are left out.
//
// An Ernest block of the README is quoted from the program and never written
// for the page. Each part of a block of README.md fenced as `ernest`, the
// block's lines between two blank lines, stands as consecutive lines in one
// tracked module under src/, test/ or examples/, as the module is written or
// once its comment lines, each that begins with `//`, its indentation aside,
// are taken out; lines are compared whole, indentation and all. Each part
// that does not is a line on standard error naming the file and the line the
// part begins on, and the program ends with status 1. Where the README is not
// tracked, nothing is held.
//
// The design's sections are held both ways, as CLAUDE.md's *The work* asks. A
// section is a heading of docs/design.md, `## n. Title`; a citation is a
// `§n` after the word design in a comment of a tracked module under src/,
// test/ or examples/, `design §9`, or after a citation and its comma,
// `design §11, §12`, and `§n.m` cites section n. A comment is read as a line
// that begins with `//`, its indentation aside. Every citation names a
// section, and every section is cited by a test's comment, the `//` lines
// directly above a top-level `let` of a `Test.Case`, exported or not, a doc
// block not among them; a line on standard error names each that does not,
// and the program ends with status 1. Where no design is tracked, nothing is
// held.
//
// The project's history stays out of the code and of what a user reads
// (CLAUDE.md, *Writing*), read by the project's own forms, a bare word let
// through. A comment, a line of a tracked module under src/, test/,
// examples/ or tools/ that begins with `//`, names no milestone, step or item
// of the plan by the word and a number after it, MVP among the words and its
// number written with the space or without; no finding by its name after the
// word finding; neither the plan's file nor the findings'; and no date of
// this century. A log entry's title, `the log's *Title*`, is cut out first,
// and a comment after code or a block comment is not read. A line of the
// README, of CHANGES.md or of a module under src/, a comment aside, names no
// milestone, step or item with its number. A line of CHANGES.md from its
// first `## ` heading on, a heading aside, holds no date and no `; *Title*`,
// and names no finding by its name, neither file, and no reader of a review
// by its kind, a cold, code, documents, independent or security reader. Each
// finding is a line on standard error naming the file and the line, and the
// program ends with status 1.
//
//     make test    runs it, as ern run tools/build/docs.erc
//

// A paragraph past the measure: where it begins, its words, and its first
// characters.
type Paragraph = Paragraph(file : String, line : Int, words : Int, first : String)

// Where the reading stands as a document's lines go by: the line's number,
// whether it is inside a fence, the paragraph begun and not yet ended, and
// the paragraphs found.
type Reading =
    Reading(line : Int,
            fence : Bool,
            start : Int,
            first : String,
            words : Int,
            skip : Bool,
            item : Bool,
            indent : Int,
            found : List(Paragraph))

// What git tracks, as a backticked path is held to it: the directories at
// the top that hold a tracked file, each with its "/", and the tracked files
// with the directories that hold them.
type Held = Held(tops : List(String), paths : Set(String))

// A word of a comment and the line it stands on.
type Word = Word(line : Int, text : String)

// A section a comment cites, and the line the citation stands on.
type Citation = Citation(line : Int, section : Int)

// Where the reading of a document's blocks of commands stands as its lines go
// by: whether it is inside a fence and whether that block is read, whether
// the line before was a command or a line under one, whether that command
// runs on, and the lines found.
type CommandReading =
    CommandReading(fence : Bool, read : Bool, under : Bool, runsOn : Bool, found : List(String))

// A part of an Ernest block: the line it begins on, from 1, and its lines.
type Part = Part(line : Int, lines : List(String))

// Where the reading of a document's Ernest blocks stands as its lines go by:
// whether it is inside a fence and whether that block is Ernest, the part
// begun, none while its lines are empty, and the parts found.
type BlockReading = BlockReading(fence : Bool, ernest : Bool, part : Part, parts : List(Part))

let readme : String = "README.md"

let design : String = "docs/design.md"

let changes : String = "CHANGES.md"

let measure : Int = 150

// The bytes of a paragraph's beginning shown, its last character whole.
let shownBytes : Int = 60

let notice : String =
    "paragraphs past 150 words, which no reader takes in whole; split each at its turn:"

let untracked : String = "docs: git tracks no file here; git add the repository's files first"

export fn main() : Unit = {
    let names = tracked();
    let files = List.filter(names, fn(name) = String.endsWith(name, ".md"));
    let modules =
        List.map(List.filter(names, fn(name) = String.endsWith(name, ".ern")),
                 fn(module) = #(module, String.lines(contents(module))));
    let held = heldOf(names);
    let long = List.flatMap(List.filter(files, isMeasured), paragraphsIn);
    if List.isEmpty(long) then
        Unit
    else {
        Io.printlnError(notice);
        List.forEach(long, fn(paragraph) = Io.printlnError(shown(paragraph)))
    };
    let missing =
        List.unique(List.flatMap(List.filter(files, isChecked),
                                 fn(file) = missingIn(file, contents(file), held)));
    let failures =
        missing
            <> commands(files)
            <> quoted(files, modules)
            <> uncited(files, modules)
            <> timeline(files, modules);
    List.forEach(failures, Io.printlnError);
    if List.isEmpty(failures) && List.isEmpty(long) then Unit else Os.exit(1)
}

//
// The repository
//

// The files git tracks, each name as written, past ASCII too; the program
// ends where git tracks none.
fn tracked() : List(String) = {
    let command = Os.command("git", ["-c", "core.quotePath=false", "ls-files", "-z"]);
    let names = match Os.run(command, 5000) {
        Right(finished) when finished.status == 0 -> trackedOf(finished.stdout)
      | _ -> Left("docs: git ls-files failed")
    };
    match names {
        Right(names) ->
            names
      | Left(cause) -> {
            Io.printlnError(cause);
            Os.exit(1)
        }
    }
}

// The names git's output holds, each ended by a NUL, or the line for
// standard error where it holds none or is not UTF-8.
fn trackedOf(output : Bytes) : Either(String, List(String)) =
    Either.andThen(decoded("git ls-files", output), fn(text) = {
        let names =
            List.filter(String.split(text, "\u{0}"), fn(name) = String.isEmpty(name) == false);
        if List.isEmpty(names) then Left(untracked) else Right(names)
    })

// The directories at the top of the repository that hold a tracked file,
// each with its "/", and every tracked file with each directory that holds
// it, "a" and "a/b" for "a/b/c.md".
fn heldOf(names : List(String)) : Held = {
    let tops =
        List.filterMap(names,
                       fn(name) =
                           Optional.map(String.splitOnce(name, "/"), fn(#(top, _)) = top <> "/"));
    Held(tops = List.unique(tops), paths = Set.fromList(names <> List.flatMap(names, holdersOf)))
}

fn holdersOf(name : String) : List(String) = {
    let parts = String.split(name, "/");
    List.map(List.range(1, List.size(parts) - 1),
             fn(count) = String.join(List.take(parts, count), "/"))
}

fn contents(file : String) : String = {
    let read = match Fs.read(Path(file), 5000) {
        Right(bytes) -> decoded(file, bytes)
      | Left(error) -> Left("docs: cannot read " <> file <> ": " <> Io.show(error))
    };
    match read {
        Right(text) ->
            text
      | Left(cause) -> {
            Io.printlnError(cause);
            Os.exit(1)
        }
    }
}

// The bytes as text, or the line for standard error, which names what they
// were read from, where they are not UTF-8.
fn decoded(source : String, bytes : Bytes) : Either(String, String) =
    Either.fromOptional(String.fromUtf8(bytes), "docs: " <> source <> ": not UTF-8")

//
// The paths
//

// Each backticked path of the file's text that git does not hold, as a line
// for standard error.
fn missingIn(file : String, text : String, held : Held) : List(String) =
    List.filterMap(pathsIn(text, held.tops),
                   fn(#(line, path)) =
                       if Set.contains(held.paths, path) then
                           None
                       else
                           Some(placeOf(file, line) <> "`" <> path <> "` names nothing"))

// The backticked pieces of the text outside fenced code that begin with one
// of the tops, each with its line; a wildcard or a metavariable, `<name>`,
// names no one file, a piece that ends with "/" names a directory the writer
// did not mean to pin, one that holds a space is a command line, whose first
// word is the program the line runs and not a path the document pins, and a
// manual page or a module page is there only in a library's archive.
fn pathsIn(text : String, tops : List(String)) : List(#(Int, String)) = {
    let pieces = String.split(unfenced(text), "`");
    let #(_, placed) =
        List.mapFold(pieces,
                     1,
                     fn(line, piece) =
                         #(line + List.size(String.split(piece, "\n")) - 1, #(line, piece)));
    List.filterMap(List.indexed(placed), fn(indexed) = match indexed {
        #(index, #(line, piece)) when index % 2 == 1 && isPath(piece, tops) -> Some(#(line, piece))
      | _ -> None
    })
}

fn isPath(piece : String, tops : List(String)) : Bool =
    List.any(tops, fn(top) = String.startsWith(piece, top))
        && String.startsWith(piece, "docs/man/") == false
        && String.startsWith(piece, "docs/modules/") == false
        && String.contains(piece, "*") == false
        && String.contains(piece, "<") == false
        && String.contains(piece, " ") == false
        && String.endsWith(piece, "/") == false

// The text with its fenced blocks and their fences as empty lines, so that
// each line keeps its number.
fn unfenced(text : String) : String = {
    let kept = List.foldLeft(String.lines(text), #(false, []), fn(acc, line) = match acc {
        #(fence, lines) ->
            if isFence(line) then
                #(fence == false, "" :: lines)
            else if fence then
                #(fence, "" :: lines)
            else
                #(fence, line :: lines)
    });
    match kept {
        #(_, lines) -> String.join(List.reverse(lines), "\n")
    }
}

fn isFence(line : String) : Bool = {
    let trimmed = String.trimStart(line);
    String.startsWith(trimmed, "```") || String.startsWith(trimmed, "~~~")
}

//
// The paragraphs
//

// Whether a file's paths are checked: the plan and a proposal name paths not
// yet written, the findings the paths of the tree their readers read, and a
// log the paths there when its entry was written.
fn isChecked(file : String) : Bool =
    List.contains(["docs/plan.md", "docs/findings.md", "docs/log.md", "TEMPLATE_LOG.md"], file)
        == false
        && String.startsWith(file, "docs/proposals/") == false

// Whether a file's paragraphs are measured: the log is history and a
// proposal is thinking.
fn isMeasured(file : String) : Bool =
    file != "docs/log.md" && String.startsWith(file, "docs/proposals/") == false

fn paragraphsIn(file : String) : List(Paragraph) =
    paragraphsOf(file, contents(file))

// The paragraphs of the text past the measure. A paragraph ends at a blank
// line, at a fence, at a list item, and where a list item's lines stop being
// indented past the item; a heading, a table row and a tag, each read on its
// trimmed line, begin no paragraph that is measured.
fn paragraphsOf(file : String, text : String) : List(Paragraph) = {
    let begun =
        Reading(line = 0,
                fence = false,
                start = 0,
                first = "",
                words = 0,
                skip = false,
                item = false,
                indent = 0,
                found = []);
    let last =
        List.foldLeft(String.lines(text),
                      begun,
                      fn(reading, line) =
                          read(file, Reading(..reading, line = reading.line + 1), line));
    List.reverse(ended(file, last).found)
}

fn read(file : String, reading : Reading, line : String) : Reading =
    if isFence(line) then
        Reading(..ended(file, reading), fence = reading.fence == false)
    else if reading.fence then
        reading
    else if String.isEmpty(String.trim(line)) then
        ended(file, reading)
    else if isItem(line) then
        counted(file, Reading(..ended(file, reading), item = true), line)
    else
        counted(file, reading, line)

// The line's words added to the paragraph, which it begins where none is
// begun, or where it stands at or before a list item's indentation.
fn counted(file : String, reading : Reading, line : String) : Reading = {
    let indent = indentation(line);
    let begun = if reading.words == 0 then
        Reading(..reading, start = reading.line, first = line, =indent, skip = isUnmeasured(line))
    else if reading.item && indent <= reading.indent then
        Reading(..ended(file, reading),
                start = reading.line,
                first = line,
                =indent,
                skip = isUnmeasured(line))
    else
        reading;
    Reading(..begun, words = begun.words + List.size(String.words(line)))
}

// The paragraph ended: kept where it is measured and past the measure.
fn ended(file : String, reading : Reading) : Reading = {
    let found = if reading.skip == false && reading.words > measure then
        Paragraph(=file,
                  line = reading.start,
                  words = reading.words,
                  first = beginning(reading.first))
            :: reading.found
    else
        reading.found;
    Reading(..reading, words = 0, item = false, =found)
}

// A heading, a table row and an HTML line, which are no prose, indented or
// not.
fn isUnmeasured(line : String) : Bool = {
    let trimmed = String.trimStart(line);
    String.startsWith(trimmed, "#")
        || String.startsWith(trimmed, "|")
        || String.startsWith(trimmed, "<")
}

// A list item: "- ", "* ", or a number, a small letter or none, a dot and a
// space, "1. " or "1a. ".
fn isItem(line : String) : Bool = {
    let chars = String.toList(String.trimStart(line));
    isBullet(chars)
        || match afterNumber(chars) {
            Some('.' :: ' ' :: _) -> true
          | Some(letter :: '.' :: ' ' :: _) -> letter >= 'a' && letter <= 'z'
          | _ -> false
        }
}

fn isBullet(chars : List(Char)) : Bool =
    match chars {
        '-' :: ' ' :: _ -> true
      | '*' :: ' ' :: _ -> true
      | _ -> false
    }

// The characters after the digits the characters begin with, or `None`
// where they begin with none.
fn afterNumber(chars : List(Char)) : Optional(List(Char)) = {
    let #(digits, rest) = List.span(chars, Char.isAsciiDigit);
    if List.isEmpty(digits) then None else Some(rest)
}

// The number of a word "n.", a section's.
fn numbered(word : String) : Optional(Int) =
    if String.endsWith(word, ".") then
        String.toInt(String.slice(word, 0, String.size(word) - 1))
    else
        None

fn indentation(line : String) : Int =
    String.size(line) - String.size(String.trimStart(line))

// The line's first bytes as a finding shows them, a character they cut short
// left out.
fn beginning(line : String) : String = {
    let #(text, _) = String.fromUtf8Piece(Bytes.slice(String.toUtf8(line), 0, shownBytes));
    text
}

fn shown(paragraph : Paragraph) : String =
    placeOf(paragraph.file, paragraph.line)
        <> Int.toString(paragraph.words)
        <> " words  "
        <> paragraph.first

// The place a finding's line on standard error begins with: the file, the
// line, from 1, and ": ".
fn placeOf(file : String, line : Int) : String =
    file <> ":" <> Int.toString(line) <> ": "

//
// The commands
//

// Each line of a block of commands whose description is not after "#", in
// the files whose paragraphs are measured, as a line for standard error.
fn commands(files : List(String)) : List(String) =
    List.flatMap(List.filter(files, isMeasured),
                 fn(file) = commandsOf(file, String.lines(contents(file))))

// The lines of every fenced block but an Ernest one that give a description
// not after "#": a command with two spaces before its "#", or in the whole
// line where it has none, and a line indented under a command, or under
// another such line, that does not begin with "#". A command that ends in
// "\" runs on to the next line, which is read as the command.
fn commandsOf(file : String, lines : List(String)) : List(String) = {
    let begun =
        CommandReading(fence = false, read = false, under = false, runsOn = false, found = []);
    let last =
        List.foldLeft(List.indexed(lines),
                      begun,
                      fn(reading, #(index, line)) =
                          readCommand(placeOf(file, index + 1), reading, line));
    List.reverse(last.found)
}

fn readCommand(place : String, reading : CommandReading, line : String) : CommandReading = {
    let trimmed = String.trim(line);
    if isFence(line) then
        CommandReading(..reading,
                       fence = reading.fence == false,
                       read = isRead(trimmed),
                       under = false,
                       runsOn = false)
    else if reading.fence == false || reading.read == false then
        reading
    else if reading.runsOn || isCommand(trimmed) then {
        let found = if isBare(trimmed) then
            (place <> "a description beside a command does not begin with `#`") :: reading.found
        else
            reading.found;
        CommandReading(..reading, under = true, runsOn = String.endsWith(trimmed, "\\"), =found)
    } else if reading.under && indentation(line) > 0 && String.isEmpty(trimmed) == false then {
        let found = if String.startsWith(trimmed, "#") then
            reading.found
        else
            (place <> "a line under a command does not begin with `#`") :: reading.found;
        CommandReading(..reading, =found)
    } else
        CommandReading(..reading, under = false, runsOn = false)
}

// Whether the block a fence opens is read: every block but an Ernest one.
fn isRead(fence : String) : Bool =
    isErnest(fence) == false

// Whether a fence names Ernest as its block's language.
fn isErnest(fence : String) : Bool =
    match String.words(String.drop(fence, 3)) {
        language :: _ -> language == "ernest"
      | [] -> false
    }

// A command: make and its words, or ern or a launcher under bin/ and a word
// at least, after an optional sudo and words VAR=value.
fn isCommand(trimmed : String) : Bool = {
    let #(_, words) =
        List.span(String.words(trimmed), fn(word) = word == "sudo" || isAssignment(word));
    match words {
        program :: _ when program == "make" -> true
      | program :: _ :: _ -> program == "ern" || String.startsWith(program, "bin/")
      | _ -> false
    }
}

fn isAssignment(word : String) : Bool =
    String.contains(word, "=") && String.startsWith(word, "-") == false

// Whether a command's description is bare: two spaces stand before the
// command's "#", or in the whole line where it has none.
fn isBare(trimmed : String) : Bool = {
    let command = match String.splitOnce(trimmed, " #") {
        Some(#(before, _)) -> before
      | None -> trimmed
    };
    String.contains(String.trimEnd(command), "  ")
}

//
// The README's Ernest blocks
//

// Each part of the README's Ernest blocks that stands in no module of the
// program, as a line for standard error; none where the README is not
// tracked.
fn quoted(files : List(String), modules : List(#(String, List(String)))) : List(String) =
    if List.contains(files, readme) then {
        let programs = List.filter(modules, fn(#(module, _)) = isProgram(module));
        unquoted(readme,
                 String.lines(contents(readme)),
                 List.map(programs, fn(#(_, lines)) = lines))
    } else
        []

// Each part of the file's Ernest blocks that stands as consecutive lines in
// none of the modules, as each is written or once its comment lines are
// taken out, as a line for standard error.
fn unquoted(file : String, lines : List(String), modules : List(List(String))) : List(String) = {
    let sources = List.flatMap(modules, fn(module) = [framed(module), framed(uncommented(module))]);
    List.filterMap(partsOf(lines), fn(part) = unquotedPart(file, part, sources))
}

fn unquotedPart(file : String, part : Part, sources : List(String)) : Optional(String) =
    if List.any(sources, fn(source) = String.contains(source, framed(part.lines))) then
        None
    else
        Some(placeOf(file, part.line) <> "a part of an Ernest block stands in no tracked module")

// The lines as one text with a line break before and after, so that one
// framed text holds another only where the other's lines stand whole and
// consecutive among its own.
fn framed(lines : List(String)) : String =
    "\n" <> String.join(lines, "\n") <> "\n"

fn uncommented(lines : List(String)) : List(String) =
    List.filter(lines, fn(line) = isComment(line) == false)

// The parts of the Ernest blocks among the lines: each block's lines between
// two blank lines, or between a blank line and a fence.
fn partsOf(lines : List(String)) : List(Part) = {
    let begun =
        BlockReading(fence = false, ernest = false, part = Part(line = 0, lines = []), parts = []);
    let last =
        List.foldLeft(List.indexed(lines),
                      begun,
                      fn(reading, #(index, line)) = readBlock(index + 1, reading, line));
    List.reverse(last.parts)
}

fn readBlock(number : Int, reading : BlockReading, line : String) : BlockReading =
    if isFence(line) then
        BlockReading(..partEnded(reading),
                     fence = reading.fence == false,
                     ernest = isErnest(String.trim(line)))
    else if reading.fence == false || reading.ernest == false then
        reading
    else if String.isEmpty(String.trim(line)) then
        partEnded(reading)
    else if List.isEmpty(reading.part.lines) then
        BlockReading(..reading, part = Part(line = number, lines = [line]))
    else
        BlockReading(..reading, part = Part(..reading.part, lines = reading.part.lines <> [line]))

// The part begun, where one is, kept among the parts found.
fn partEnded(reading : BlockReading) : BlockReading =
    if List.isEmpty(reading.part.lines) then
        reading
    else
        BlockReading(..reading,
                     part = Part(line = 0, lines = []),
                     parts = reading.part :: reading.parts)

//
// The design's citations
//

// Each citation that names no section of the design, and each section no
// test cites, as lines for standard error; none where there is no design.
fn uncited(files : List(String), modules : List(#(String, List(String)))) : List(String) =
    if List.contains(files, design) then {
        let sections = sectionsOf(contents(design));
        let programs = List.filter(modules, fn(#(module, _)) = isProgram(module));
        let tested = List.flatMap(programs, fn(#(_, lines)) = testedIn(lines));
        List.flatMap(programs, fn(#(module, lines)) = unknownIn(module, lines, sections))
            <> List.filterMap(sections, fn(section) = untested(section, tested))
    } else
        []

// Whether a module is the program's, whose comments cite the design: one
// under src/, test/ or examples/, and not the checker's own under tools/.
fn isProgram(file : String) : Bool =
    List.any(["src/", "test/", "examples/"], fn(root) = String.startsWith(file, root))

// The sections of the design: each heading "## n. Title" outside fenced
// code, by its number.
fn sectionsOf(text : String) : List(Int) =
    List.filterMap(String.lines(unfenced(text)), fn(line) = match String.words(line) {
        "##" :: word :: _ :: _ -> numbered(word)
      | _ -> None
    })

// Each citation of the module that names no section, as a line for standard
// error.
fn unknownIn(module : String, lines : List(String), sections : List(Int)) : List(String) = {
    let unknown =
        List.filter(citationsIn(commentWords(lines)),
                    fn(citation) = List.contains(sections, citation.section) == false);
    List.map(unknown, fn(citation) = shownUnknown(module, citation))
}

fn shownUnknown(module : String, citation : Citation) : String =
    placeOf(module, citation.line)
        <> "design §"
        <> Int.toString(citation.section)
        <> " is no section of "
        <> design

fn untested(section : Int, tested : List(Int)) : Optional(String) =
    if List.contains(tested, section) then
        None
    else
        Some(design <> ": §" <> Int.toString(section) <> " has no test naming it")

// The sections the module's tests cite: the citations of each test's
// comment, the lines of "//" directly above it, a doc block's "///" not
// among them, since a doc block puts the test on the module's page.
fn testedIn(lines : List(String)) : List(Int) = {
    let withNext = List.indexed(List.zip(lines, List.drop(lines, 1) <> [""]));
    let #(_, tested) = List.foldLeft(withNext, #([], []), testedStep);
    tested
}

// A step of the reading, each line with its index and the line after it:
// the words of the comment directly above carried while its lines go by,
// and its sections kept where a test's let ends it.
fn testedStep(#(above, tested) : #(List(Word), List(Int)),
              #(index, #(line, next)) : #(Int, #(String, String))) : #(List(Word), List(Int)) =
    if isTestComment(line) then
        #(above <> wordsAt(index, line), tested)
    else if isTest(line, next) then
        #([], tested <> List.map(citationsIn(above), fn(citation) = citation.section))
    else
        #([], tested)

// A line of a test's comment: "//", or "////", which begins an ordinary
// comment (report §2.2), and not a doc block's "///".
fn isTestComment(line : String) : Bool = {
    let trimmed = String.trimStart(line);
    String.startsWith(trimmed, "//")
        && (String.startsWith(trimmed, "///") == false || String.startsWith(trimmed, "////"))
}

// A top-level let of a Test.Case, exported or not, the Test.Case on its line
// or, where the formatter split the let after its "=", on the next.
fn isTest(line : String, next : String) : Bool =
    String.startsWith(Optional.withDefault(String.stripPrefix(line, "export "), line), "let ")
        && (String.contains(line, "Test.Case(")
                || (String.endsWith(line, "=")
                        && String.startsWith(String.trimStart(next), "Test.Case(")))

// The words of the module's comments, each with its line.
fn commentWords(lines : List(String)) : List(Word) =
    List.flatMap(List.indexed(lines), fn(#(index, line)) = wordsAt(index, line))

// The words of the line at the index, from 0, where it is a comment, the
// slashes that begin it left out; none where it is not.
fn wordsAt(index : Int, line : String) : List(Word) = {
    let trimmed = String.trimStart(line);
    if String.startsWith(trimmed, "//") then {
        let #(_, comment) = List.span(String.toList(trimmed), fn(char) = char == '/');
        List.map(String.words(String.fromList(comment)),
                 fn(word) = Word(line = index + 1, text = word))
    } else
        []
}

// The citations among the words: each "§n" after the word design, or
// "(design", on its line or the next, and each after a citation and its
// comma.
fn citationsIn(words : List(Word)) : List(Citation) =
    match words {
        word :: rest when word.text == "design" || word.text == "(design" -> listed(word, rest)
      | _ :: rest -> citationsIn(rest)
      | [] -> []
    }

// The citations from the word after the previous one, where it stands on
// the previous one's line or the next and cites a section, and on through
// a list while each ends with a comma; then the rest are read again.
fn listed(previous : Word, words : List(Word)) : List(Citation) =
    match words {
        word :: rest when word.line <= previous.line + 1 ->
            match cited(word.text) {
                Some(section) ->
                    Citation(line = word.line, =section)
                        :: (if String.endsWith(word.text, ",") then
                                listed(word, rest)
                            else
                                citationsIn(rest))
              | None ->
                    citationsIn(words)
            }
      | _ ->
            citationsIn(words)
    }

// The section a word "§n" or "§n.m" cites, whatever follows its digits.
fn cited(text : String) : Optional(Int) =
    if String.startsWith(text, "§") then {
        let number = String.toList(String.slice(text, 1, String.size(text)));
        let #(digits, _) = List.span(number, Char.isAsciiDigit);
        String.toInt(String.fromList(digits))
    } else
        None

//
// The project's history
//

// What the history's checks find, as lines for standard error.
fn timeline(files : List(String), modules : List(#(String, List(String)))) : List(String) = {
    let read = List.filter([readme, changes], fn(file) = List.contains(files, file));
    historyIn(List.map(read, fn(file) = #(file, String.lines(contents(file)))), modules)
}

// What the history's checks find in the documents and the modules, each with
// its lines: a module's comments under src/, test/, examples/ and tools/,
// the documents' lines and a module's code under src/, and the notes of the
// changes.
fn historyIn(documents : List(#(String, List(String))),
             modules : List(#(String, List(String)))) : List(String) = {
    let numbered = List.map(documents, fn(#(file, lines)) = #(file, List.indexed(lines)));
    let sources =
        List.filter(modules,
                    fn(#(module, _)) = isProgram(module) || String.startsWith(module, "tools/"));
    let printed =
        List.filterMap(modules,
                       fn(#(module, lines)) =
                           if String.startsWith(module, "src/") then
                               Some(#(module, codeOf(lines)))
                           else
                               None);
    List.flatMap(sources,
                 fn(#(module, lines)) = naming(module, commentsOf(lines), "a comment", historyAt))
        <> List.flatMap(printed <> numbered,
                        fn(#(file, lines)) = naming(file, lines, "the line", stepAt))
        <> List.flatMap(List.filter(numbered, fn(#(file, _)) = file == changes),
                        fn(#(_, lines)) = naming(changes, sectionsIn(lines), "the note", noteAt))
}

// Each kind a line names, once, as a line for standard error: what its
// words name from each word on, each word as written and bare.
fn naming(file : String,
          lines : List(#(Int, String)),
          what : String,
          kindAt : (List(#(String, String))) -> Optional(String)) : List(String) =
    List.flatMap(lines, fn(#(index, line)) = {
        let words = List.map(String.words(line), fn(word) = #(word, bare(word)));
        let place = placeOf(file, index + 1) <> what <> " names ";
        List.map(List.unique(List.filterMap(tailsOf(words), kindAt)), fn(kind) = place <> kind)
    })

fn tailsOf(words : List(#(String, String))) : List(List(#(String, String))) =
    match words {
        _ :: rest -> words :: tailsOf(rest)
      | [] -> []
    }

// The module's comment lines by index, each without `the log's *Title*`, a
// title that runs on cut to the line's end.
fn commentsOf(lines : List(String)) : List(#(Int, String)) =
    List.map(List.filter(List.indexed(lines), fn(#(_, line)) = isComment(line)),
             fn(#(index, line)) = #(index, untitled(line)))

// The module's lines by index but its comment lines, which the comments'
// check reads.
fn codeOf(lines : List(String)) : List(#(Int, String)) =
    List.filter(List.indexed(lines), fn(#(_, line)) = isComment(line) == false)

// A comment line: one that begins with "//", its indentation aside.
fn isComment(line : String) : Bool =
    String.startsWith(String.trimStart(line), "//")

fn untitled(line : String) : String =
    match String.splitOnce(line, "the log's *") {
        Some(#(before, title)) ->
            before
                <> match String.splitOnce(title, "*") {
                    Some(#(_, rest)) -> untitled(rest)
                  | None -> ""
                }
      | None ->
            line
    }

// The lines by index from the first heading "## " on, the headings left
// out.
fn sectionsIn(lines : List(#(Int, String))) : List(#(Int, String)) = {
    let isProse = fn(#(_, line) : #(Int, String)) = String.startsWith(line, "## ") == false;
    let #(_, sections) = List.span(lines, isProse);
    List.filter(sections, isProse)
}

// What a comment names from its word on: a milestone, a step or an item with
// its number, a finding by its name, the plan's file or the findings', or a
// date.
fn historyAt(words : List(#(String, String))) : Optional(String) =
    match #(stepAt(words), recordAt(words), words) {
        #(Some(kind), _, _) -> Some(kind)
      | #(_, Some(kind), _) -> Some(kind)
      | #(_, _, #(_, word) :: _) when isDate(word) -> Some("a date")
      | _ -> None
    }

// What a user reads names of the plan from a word on: a milestone, a step or
// an item by the word and a number after it, "MVP" among the words and its
// number written with the space or without.
fn stepAt(words : List(#(String, String))) : Optional(String) =
    match words {
        #(_, word) :: #(_, number) :: _ when isNumber(number) ->
            numberedKind(word)
      | #(_, word) :: _ when String.startsWith(word, "MVP") && isNumber(String.drop(word, 3)) ->
            Some("a milestone")
      | _ ->
            None
    }

// The kind of a step the word names where a number follows it.
fn numberedKind(word : String) : Optional(String) =
    if word == "MVP"
        || List.contains(["milestone", "milestones", "Milestone", "Milestones"], word) then
        Some("a milestone")
    else if List.contains(["step", "steps", "Step", "Steps"], word) then
        Some("a step")
    else if List.contains(["item", "items", "Item", "Items"], word) then
        Some("an item")
    else
        None

// What the review's and the plan's records are named by from a word on: a
// finding's name after the word finding, and the plan's file or the
// findings'.
fn recordAt(words : List(#(String, String))) : Optional(String) =
    match words {
        #(_, word) :: #(_, name) :: _ when isFindingWord(word) && isFindingName(name) ->
            Some("a finding")
      | #(raw, _) :: _ when namesFile(raw, "plan.md") ->
            Some("the plan's file")
      | #(raw, _) :: _ when namesFile(raw, "findings.md") ->
            Some("the findings' file")
      | _ ->
            None
    }

fn isFindingWord(word : String) : Bool =
    List.contains(["finding", "findings", "Finding", "Findings"], word)

// Whether the word as written names the file at the top or under a
// directory, the punctuation around it and a trailing "'s" aside.
fn namesFile(raw : String, file : String) : Bool = {
    let word = bare(raw);
    let name = bare(Optional.withDefault(String.stripSuffix(word, "'s"), word));
    name == file || String.endsWith(name, "/" <> file)
}

// What a release's note names from a word on that it leaves out, since its
// reader is a user.
fn noteAt(words : List(#(String, String))) : Optional(String) =
    match #(recordAt(words), words) {
        #(Some(kind), _) -> Some(kind)
      | #(_, #(_, word) :: _) when isDate(word) -> Some("a date outside its heading")
      | #(_, #(raw, _) :: #(next, _) :: _) when String.endsWith(raw, ";")
            && String.startsWith(next, "*") -> Some("a log entry's title")
      | #(_, #(_, word) :: #(_, next) :: _) when isReader(word, next) -> Some("a reader")
      | _ -> None
    }

// Whether the two words name a review's reader by its kind, as "a cold
// reader" does.
fn isReader(word : String, next : String) : Bool =
    List.contains(["cold", "code", "documents", "independent", "security"], word)
        && List.contains(["reader", "readers"], next)

// The word without the punctuation around it, a quotation mark among it.
fn bare(word : String) : String = {
    let isMark =
        fn(char : Char) = List.contains(['(', ')', ',', ';', ':', '.', '*', '`', '"'], char);
    let #(_, rest) = List.span(String.toList(word), isMark);
    let #(_, kept) = List.span(List.reverse(rest), isMark);
    String.fromList(List.reverse(kept))
}

// A finding's name: one capital or two, a dash or none, and a number, as E4
// and S-2 are.
fn isFindingName(word : String) : Bool = {
    let #(capitals, rest) =
        List.span(String.toList(word),
                  fn(char) = Char.isUpper(char) && Char.toCodePoint(char) < 128);
    let number = match rest {
        '-' :: digits -> digits
      | _ -> rest
    };
    List.contains([1, 2], List.size(capitals))
        && List.isEmpty(number) == false
        && List.all(number, Char.isAsciiDigit)
}

// A date of this century: four digits beginning 20, two and two, joined by
// dashes.
fn isDate(word : String) : Bool =
    match String.split(word, "-") {
        [year, month, day] ->
            String.startsWith(year, "20")
                && List.map([year, month, day], String.size) == [4, 2, 2]
                && List.all(String.toList(year <> month <> day), Char.isAsciiDigit)
      | _ ->
            false
    }

fn isNumber(word : String) : Bool =
    match String.toList(word) {
        char :: _ -> Char.isAsciiDigit(char)
      | [] -> false
    }

//
// Tests
//

let pastMeasure : String = String.trim(String.repeat("word ", 151))

/// A paragraph past the measure is listed at its line; one at the measure is not.
let listsThePastMeasure = Test.Case(name = "lists a paragraph past the measure", run = fn() = {
    let text =
        "# Title\n\nshort\n\n" <> pastMeasure <> "\n\n" <> String.trim(String.repeat("w ", 150));
    Test.equal(List.map(paragraphsOf("f.md", text),
                        fn(paragraph) = #(paragraph.line, paragraph.words)),
               [#(5, 151)])
})

/// A heading, a table row, a tag and fenced code are not measured, and nor
/// is a heading, a table row or a tag that ends a list item by its
/// indentation, nor one indented under a list item after a blank line.
let leavesUnmeasured =
    Test.Case(name = "leaves a heading, a table, a tag and a fence unmeasured", run = fn() = {
        let text =
            "# "
                <> pastMeasure
                <> "\n\n| "
                <> pastMeasure
                <> "\n\n<"
                <> pastMeasure
                <> "\n\n```\n"
                <> pastMeasure
                <> "\n```\n\n- item\n# "
                <> pastMeasure
                <> "\n\n- item\n| "
                <> pastMeasure
                <> "\n\n- item\n<"
                <> pastMeasure
                <> "\n\n- item\n\n  # "
                <> pastMeasure
                <> "\n\n  | "
                <> pastMeasure
                <> "\n\n  <"
                <> pastMeasure
                <> "\n";
        Test.equal(paragraphsOf("f.md", text), [])
    })

/// A list item is a paragraph of its own, which ends at the next item and
/// where its lines stop being indented past it, a long line after it among
/// them; a numbered item may carry a letter.
let readsItems = Test.Case(name = "reads a list item as a paragraph", run = fn() = {
    let text =
        "- "
            <> pastMeasure
            <> "\n- short\n  "
            <> pastMeasure
            <> "\n"
            <> pastMeasure
            <> "\n1a. "
            <> pastMeasure
            <> "\n";
    Test.equal(List.map(paragraphsOf("f.md", text),
                        fn(paragraph) = #(paragraph.file, paragraph.line)),
               [#("f.md", 1), #("f.md", 2), #("f.md", 4), #("f.md", 5)])
})

/// A paragraph is shown by its first 60 bytes, a character they cut short
/// left out.
let showsTheBeginning = Test.Case(name = "shows a paragraph's first bytes", run = fn() = {
    let line = String.repeat("a", 59) <> "§ " <> pastMeasure;
    Test.equal(List.map(paragraphsOf("f.md", line), shown),
               ["f.md:1: 152 words  " <> String.repeat("a", 59)])
})

/// A backticked path under a top is found outside fenced code, with its
/// line; one with a wildcard, a metavariable, a space, which makes it a
/// command line, or a trailing "/" is not, nor a manual page or a module
/// page, nor one under no top.
let findsPaths = Test.Case(name = "finds the backticked paths", run = fn() = {
    let text =
        "see `src/a.ern` and `lib/*/build`, `bin/<name>`, `src/`, `other/x`\n"
            <> "`bin/a --config-dir dir b.json`\n"
            <> "```\n`src/fenced.ern`\n```\n`docs/b.md`, `docs/man/m.md`, `docs/modules/m.md`";
    Test.equal(pathsIn(text, ["src/", "docs/", "lib/", "bin/"]),
               [#(1, "src/a.ern"), #(6, "docs/b.md")])
})

/// A path is held to what git tracks: a tracked file and a directory that
/// holds one name something, and a file git does not track names nothing,
/// a line naming the file and the line; the tops are the directories at the
/// top that hold a tracked file.
let holdsPathsToGit = Test.Case(name = "holds a path to what git tracks", run = fn() = {
    let held = heldOf(["README.md", "src/a.ern", "docs/sub/b.md"]);
    let text = "`src/a.ern` and `docs/sub`, `docs/sub/b.md`\n\n`docs/notes.txt`, `README.md`\n";
    Test.equal(#(held.tops, missingIn("f.md", text, held)),
               #(["src/", "docs/"], ["f.md:3: `docs/notes.txt` names nothing"]))
})

/// The plan, the findings, the logs and the proposals have no path checked.
let leavesPathsUnchecked =
    Test.Case(name = "leaves the plan, the logs and the proposals", run = fn() = {
        let files =
            ["README.md",
             "docs/plan.md",
             "docs/findings.md",
             "docs/log.md",
             "TEMPLATE_LOG.md",
             "docs/proposals/cache/proposal.md",
             "docs/design.md"];
        Test.equal(List.filter(files, isChecked), ["README.md", "docs/design.md"])
    })

/// git's output is read at each NUL, a name past ASCII as written; where it
/// holds no name, the line for standard error says to add the files.
let readsTracked = Test.Case(name = "reads the names git tracks", run = fn() = {
    let names = String.toUtf8("README.md\u{0}docs/caf\u{e9}.md\u{0}");
    Test.equal(#(trackedOf(names), trackedOf(String.toUtf8(""))),
               #(Right(["README.md", "docs/caf\u{e9}.md"]),
                 Left("docs: git tracks no file here; git add the repository's files first")))
})

/// A file that is not UTF-8 is named in the line for standard error.
let namesTheUndecoded = Test.Case(name = "names a file that is not UTF-8", run = fn() = {
    let cut = Bytes.slice(String.toUtf8("caf\u{e9}"), 0, 4);
    Test.equal(decoded("docs/latin1.md", cut), Left("docs: docs/latin1.md: not UTF-8"))
})

/// A citation is a "§n" after the word design in a comment, on its line or
/// the next, or after a citation and its comma, "§n.m" citing section n;
/// one after another word, one after a citation with no comma, one two lines
/// after the word, and a comment after code on its line, cite nothing. A
/// citation of no section is a line naming the module and the line.
let findsCitations = Test.Case(name = "finds the design's citations", run = fn() = {
    let text =
        "// a rule (design §2) and the\n"
            <> "    // design §3.1, §4: what the formatter writes\n"
            <> "let value = 1 // design §9\n"
            <> "/// as the design\n"
            <> "/// §5, report §6, says\n"
            <> "// design §2 §3\n"
            <> "// as the design\n"
            <> "//\n"
            <> "// §4 two lines on\n";
    Test.equal(#(List.map(citationsIn(commentWords(String.lines(text))),
                          fn(citation) = #(citation.line, citation.section)),
                 unknownIn("src/a.ern", String.lines(text), [2, 3, 4])),
               #([#(1, 2), #(2, 3), #(2, 4), #(5, 5), #(6, 2)],
                 ["src/a.ern:5: design §5 is no section of docs/design.md"]))
})

/// A section is a heading "## n. Title" outside fenced code; an unnumbered
/// heading, a deeper one and a fenced one are none.
let readsSections = Test.Case(name = "reads the design's sections", run = fn() = {
    let text =
        "# Design\n\n## 1. What it does\n\n## Glossary\n\n### 2. A part\n\n"
            <> "```\n## 3. Fenced\n```\n\n## 12. Windows\n";
    Test.equal(sectionsOf(text), [1, 12])
})

/// A test cites what its comment cites, the lines of "//" directly above its
/// let, whether the formatter split the let or not and whether the let is
/// exported or not; a doc block cites nothing a test names, nor does the
/// comment of a let that is no test, nor a comment a blank line parts from
/// its test.
let findsTested = Test.Case(name = "finds the sections the tests cite", run = fn() = {
    let text =
        "// design §1, §2: one test.\n"
            <> "let first = Test.Case(name = \"a\", =run)\n\n"
            <> "// The formatter's split,\n// design §3: a second.\n"
            <> "let second =\n    Test.Case(name = \"b\", =run)\n\n"
            <> "/// design §4: a doc block.\n"
            <> "let third = Test.Case(name = \"c\", =run)\n\n"
            <> "// design §5: no test.\nlet value = 5\n\n"
            <> "// design §6: exported.\n"
            <> "export let fourth = Test.Case(name = \"d\", =run)\n\n"
            <> "// design §7: a blank line below.\n\n"
            <> "let fifth = Test.Case(name = \"e\", =run)\n";
    Test.equal(testedIn(String.lines(text)), [1, 2, 3, 6])
})

/// A comment line names no milestone, step or item of the plan with its
/// number, no finding by its name after the word, neither the plan's file
/// nor the findings', and no date, one form a line; a string, a comment
/// after code, a bare word, a name with no word before it, a date a time
/// follows, the epoch and a log entry's title are let through.
let findsHistory = Test.Case(name = "finds the history a comment names", run = fn() = {
    let refused =
        "// as Milestone 2 had it\n"
            <> "// the MVP 4 of it\n"
            <> "    /// built in MVP4.\n"
            <> "// (step 3) of it\n"
            <> "// items 4 and more\n"
            <> "// as finding C7 says\n"
            <> "// the findings S-2 and more\n"
            <> "// in `docs/plan.md`'s order\n"
            <> "// the findings.md file\n"
            <> "// written 2026-11-07.\n";
    let allowed =
        "let y = \"Milestone 2, 2026-11-07\" // step 3\n"
            <> "// type Milestone = the plan, the stops and the legs\n"
            <> "// at 2026-11-07T10:00:00Z, the MVPs 4, (A4), the reader now\n"
            <> "/// since the epoch, 1970-01-01, the log's *Milestone 2, 2026-11-07*, as said\n"
            <> "// feedback line 4, a review's E4, the plan item, steps ahead, myplan.md\n";
    Test.equal(#(naming("m.ern", commentsOf(String.lines(refused)), "a comment", historyAt),
                 naming("m.ern", commentsOf(String.lines(allowed)), "a comment", historyAt)),
               #(["m.ern:1: a comment names a milestone",
                  "m.ern:2: a comment names a milestone",
                  "m.ern:3: a comment names a milestone",
                  "m.ern:4: a comment names a step",
                  "m.ern:5: a comment names an item",
                  "m.ern:6: a comment names a finding",
                  "m.ern:7: a comment names a finding",
                  "m.ern:8: a comment names the plan's file",
                  "m.ern:9: a comment names the findings' file",
                  "m.ern:10: a comment names a date"],
                 []))
})

/// A line a user reads names no milestone, step or item of the plan with its
/// number, a space between or not; the bare word is let through.
let findsSteps = Test.Case(name = "finds a step of the plan a user reads", run = fn() = {
    let text =
        "as Milestone 2 has it\nbuilt in MVP4.\nthe steps 3 and more\nItem 2 of it\n"
            <> "the milestones, an MVP, the MVPs 4, type Milestone = x\nas MVP 4 has it\n";
    Test.equal(naming("README.md", List.indexed(String.lines(text)), "the line", stepAt),
               ["README.md:1: the line names a milestone",
                "README.md:2: the line names a milestone",
                "README.md:3: the line names a step",
                "README.md:4: the line names an item",
                "README.md:6: the line names a milestone"])
})

/// A module's comment line under src/ is read once, by the comments' check,
/// and its code by the check of what a user reads; a module under tools/ has
/// its comments read alone, and a document its every line.
let readsACommentOnce = Test.Case(name = "reads a comment of a module once", run = fn() = {
    let modules =
        [#("src/a.ern", ["// Milestone 2 added this.", "let x = \"Milestone 3\""]),
         #("tools/t.ern", ["// Milestone 2", "let x = \"Milestone 3\""])];
    Test.equal(historyIn([#("README.md", ["as Milestone 4 has it"])], modules),
               ["src/a.ern:1: a comment names a milestone",
                "tools/t.ern:1: a comment names a milestone",
                "src/a.ern:2: the line names a milestone",
                "README.md:1: the line names a milestone"])
})

/// A release's note holds a date in its heading alone, no log entry's title,
/// no finding by its name, neither the plan's file nor the findings', and no
/// reader of a review by its kind, one form a line; the file's own paragraph
/// is not read, nor a heading, a date a time follows, a bare word, the
/// plan, a review, a reader, a newcomer, or a library's readers.
let findsNotes = Test.Case(name = "finds what a release's note leaves out", run = fn() = {
    let text =
        "# Changes\n\nEach note; the plan, a review and its readers, 2026-11-07, finding C7.\n\n"
            <> "## 0.2.0, 2026-11-07\n\nThe release a newcomer reads, the reader now.\n\n"
            <> "- A change: §3; *A Log Entry*\n"
            <> "- Done 2026-11-06, as the plan says.\n"
            <> "- Read by the code reader of the Review: §4.\n"
            <> "- As finding C7 found: §5.\n"
            <> "- Ordered by `docs/plan.md`: §6.\n"
            <> "- Named in docs/findings.md: §7.\n"
            <> "- `Time.parse(\"2026-11-07T10:00:00Z\")`, the response readers, preview: §8.\n";
    Test.equal(naming(changes, sectionsIn(List.indexed(String.lines(text))), "the note", noteAt),
               ["CHANGES.md:9: the note names a log entry's title",
                "CHANGES.md:10: the note names a date outside its heading",
                "CHANGES.md:11: the note names a reader",
                "CHANGES.md:12: the note names a finding",
                "CHANGES.md:13: the note names the plan's file",
                "CHANGES.md:14: the note names the findings' file"])
})

/// A command in a fenced block gives its description after "#", and a line
/// indented under it begins with "#"; a "VAR=value" or a sudo before the
/// command is read past, a "\" runs the command on to the next line, and a
/// launcher with no word, a line outside a fence and an Ernest block are not
/// read as commands.
let findsCommands = Test.Case(name = "finds a command's description not after #", run = fn() = {
    let text =
        "```\n"
            <> "make test       the layout,\n"
            <> "                then the documents\n"
            <> "make            # builds\n"
            <> "                # and more\n"
            <> "sudo make install  into /usr/local\n"
            <> "ERN=bin/ern make  builds\n"
            <> "ern run a.erc \\\n"
            <> "    --load-path build  # the path\n"
            <> "bin/name\n"
            <> "    what it is\n"
            <> "```\n"
            <> "make test       outside a block\n"
            <> "```ernest\n"
            <> "make  x\n"
            <> "```\n";
    Test.equal(commandsOf("f.md", String.lines(text)),
               ["f.md:2: a description beside a command does not begin with `#`",
                "f.md:3: a line under a command does not begin with `#`",
                "f.md:6: a description beside a command does not begin with `#`",
                "f.md:7: a description beside a command does not begin with `#`"])
})

let quotedSource : List(String) =
    String.lines("// The counter.\n"
                     <> "fn count(total : Int) : Int =\n"
                     <> "    // one more\n"
                     <> "    total + 1\n\n"
                     <> "fn double(total : Int) : Int = {\n"
                     <> "    let twice = total * 2;\n"
                     <> "    twice\n"
                     <> "}\n")

let quotedNowhere : String = ": a part of an Ernest block stands in no tracked module"

/// A part of an Ernest block that stands in one of the modules holds.
let holdsAQuotedPart = Test.Case(name = "holds a part quoted from a module", run = fn() = {
    let text =
        "# Name\n\n```ernest\nfn double(total : Int) : Int = {\n    let twice = total * 2;\n```\n";
    Test.equal(unquoted("README.md", String.lines(text), [["other"], quotedSource]), [])
})

/// A part holds where it stands once the module's comment lines are taken
/// out, a comment between two of its lines in the module.
let readsPastComments =
    Test.Case(name = "holds a part the module's comments stand within", run = fn() = {
        let text = "```ernest\nfn count(total : Int) : Int =\n    total + 1\n```\n";
        Test.equal(unquoted("README.md", String.lines(text), [quotedSource]), [])
    })

/// A part holds where it stands in the module as written, comment lines and
/// all.
let holdsQuotedComments =
    Test.Case(name = "holds a part that quotes the module's comments", run = fn() = {
        let text =
            "```ernest\n// The counter.\nfn count(total : Int) : Int =\n    // one more\n"
                <> "    total + 1\n```\n";
        Test.equal(unquoted("README.md", String.lines(text), [quotedSource]), [])
    })

/// A part with a line changed is found at the line it begins on; a line is
/// compared whole, so one indented less, or cut short, is a change.
let findsAChangedPart = Test.Case(name = "finds a part with a line changed", run = fn() = {
    let text =
        "intro\n\n```ernest\nfn count(total : Int) : Int =\n    total + 2\n```\n\n"
            <> "```ernest\n  let twice = total * 2;\n\nfn count(total : Int)\n```\n";
    Test.equal(unquoted("README.md", String.lines(text), [quotedSource]),
               ["README.md:4" <> quotedNowhere,
                "README.md:9" <> quotedNowhere,
                "README.md:11" <> quotedNowhere])
})

/// A block's parts are its lines between blank lines, each held alone, so
/// only the part that stands nowhere is named.
let findsOnlyThePart = Test.Case(name = "names only the part that stands nowhere", run = fn() = {
    let text =
        "```ernest\nfn count(total : Int) : Int =\n    total + 1\n\n"
            <> "fn double(total : Int) : Int =\n    total * 2\n```\n";
    Test.equal(unquoted("README.md", String.lines(text), [quotedSource]),
               ["README.md:5" <> quotedNowhere])
})

/// Only a block fenced as Ernest is read: neither a bare block, one of
/// another language, nor a line outside a fence.
let readsOnlyErnest = Test.Case(name = "reads only a block fenced as ernest", run = fn() = {
    let text = "```\nfn nowhere() = 1\n```\n```erlang\nnowhere() -> 1.\n```\nfn nowhere() = 1\n";
    Test.equal(unquoted("README.md", String.lines(text), [quotedSource]), [])
})

/// A part whose lines stand in the module, but with a line of code between
/// two of them there, is found.
let findsLinesApart = Test.Case(name = "finds a part whose lines stand apart", run = fn() = {
    let text = "```ernest\nfn double(total : Int) : Int = {\n    twice\n}\n```\n";
    Test.equal(unquoted("README.md", String.lines(text), [quotedSource]),
               ["README.md:2" <> quotedNowhere])
})
