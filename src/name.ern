//
// Name: the program's entry point, to be written
//
// The module the launcher runs, `build/name.erc`, whose `main` is the entry
// point (report §8.1). It is the template's placeholder: rename the file to
// the program's name and write the program here, as README.md's last
// section says.
//

export fn main() : Unit =
    Io.println("name: nothing yet")

// design §1, §2, §3: the program is not written yet, and main says so; this
// test fails once main is written, and goes as real tests cite each section.
let nothingYet = Test.Case(name = "nothing yet", run = fn() = {
    let #(_, captured) = Test.capture(main);
    Test.equal(String.fromUtf8(captured.stdout), Some("name: nothing yet\n"))
})
